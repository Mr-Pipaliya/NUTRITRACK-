// Load data from localStorage or initialize
let data = JSON.parse(localStorage.getItem("nutri+")) || {
  cal: 0,
  goal: 2000,
  logs: [],
  water: 0,
  undo: null
};

// Save current state to localStorage
function save() {
  localStorage.setItem("nutri+", JSON.stringify(data));
}

// Add food entry
function addFood(name, calories) {
  data.undo = JSON.stringify(data);        // Save for undo
  data.cal += calories;                     // Update calories
  data.logs.unshift({ name, calories });    // Add log entry
  save();
  update();
}

// Undo last action
function undo() {
  if (!data.undo) return;
  data = JSON.parse(data.undo);
  save();
  update();
}

// Remove specific log entry
function remove(index) {
  data.logs.splice(index, 1);
  data.cal = data.logs.reduce((total, item) => total + item.calories, 0);
  save();
  update();
}

// Update water intake
function drink(count) {
  data.water = count;
  save();
  update();
}

// Reset all logs and water
function resetLog() {
  data.cal = 0;
  data.logs = [];
  data.water = 0;
  data.undo = null;
  save();
  update();
}

// Update UI elements
function update() {
  document.getElementById("cal").innerText = data.cal;
  document.getElementById("goal").innerText = data.goal;

  let pct = Math.min(100, Math.round((data.cal / data.goal) * 100));
  document.getElementById("percent").innerText = pct + "%";
  document.querySelector(".progress-ring").style.background =
    `conic-gradient(var(--primary) ${pct * 3.6}deg, #1e293b 0deg)`;

  // Render logs
  document.getElementById("logs").innerHTML = data.logs.map((l, i) =>
    `<div class="log">${l.name} (${l.calories}) <button onclick="remove(${i})">✕</button></div>`
  ).join("");

  // Render water buttons
  let waterHTML = "";
  for (let i = 1; i <= 8; i++) {
    waterHTML += `<button class="${i <= data.water ? 'active' : ''}" onclick="drink(${i})">💧</button>`;
  }
  document.getElementById("water").innerHTML = waterHTML;

  // Update food count
  document.getElementById("foodCount").innerText = data.logs.length;
  document.getElementById("waterCount").innerText = data.water;
}
update();
